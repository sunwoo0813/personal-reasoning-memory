{
 "manifest_version":3, "name":"PRM Activity Capture", "version":"0.1.0",
 "description":"사용자가 시작한 작업 세션의 활동을 기록합니다.",
 "minimum_chrome_version":"120",
 "permissions":["storage","tabs","webNavigation","alarms","contextMenus","scripting"],
 "host_permissions":["http://localhost:3000/*","https://*/*"],
 "background":{"service_worker":"worker.js"},
 "action":{"default_popup":"popup.html"},
 "content_scripts":[
  {"matches":["http://localhost:3000/*"],"js":["bridge.js"]},
  {"matches":["https://*/*"],"js":["capture.js"],"run_at":"document_idle"}
 ]
}
